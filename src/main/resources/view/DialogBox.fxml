<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>

<fx:root type="javafx.scene.layout.HBox" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
         alignment="TOP_RIGHT" spacing="10.0">
    <padding>
        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
    </padding>
    <ImageView fx:id="displayPicture" fitHeight="64.0" fitWidth="64.0" preserveRatio="true" />
    <Label fx:id="dialog" maxWidth="300.0" minHeight="-Infinity" text="Label" wrapText="true"
           style="-fx-background-color: #eeeeee; -fx-background-radius: 10; -fx-padding: 8;" />
</fx:root>
